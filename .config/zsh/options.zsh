HISTSIZE=120000
SAVEHIST=99999
HISTFILE="$XDG_DATA_HOME/zsh/history"
[[ -d ${HISTFILE:h} ]] || (umask 077; command mkdir -p -- "${HISTFILE:h}")

setopt SHARE_HISTORY EXTENDED_HISTORY HIST_FCNTL_LOCK
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_EXPIRE_DUPS_FIRST
setopt HIST_REDUCE_BLANKS HIST_VERIFY HIST_IGNORE_SPACE

setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT PUSHD_TO_HOME
setopt COMPLETE_IN_WORD ALWAYS_TO_END PATH_DIRS LIST_PACKED
setopt EXTENDED_GLOB GLOB_DOTS NO_CASE_GLOB NUMERIC_GLOB_SORT NO_NOMATCH
setopt INTERACTIVE_COMMENTS CORRECT NO_FLOW_CONTROL
setopt LONG_LIST_JOBS NO_HUP NO_CHECK_JOBS
setopt NO_BEEP PROMPT_SUBST TRANSIENT_RPROMPT
